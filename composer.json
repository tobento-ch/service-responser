{
    "name": "tobento/service-responser",
    "version": "2.0",
    "type": "library",
    "description": "Providing PSR-7 response wrapper classes with simplified methods.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "PSR-7 response",
        "Flash messages",
        "Flash input data"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",        
        "tobento/service-message": "^2.0",
        "tobento/service-support": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "psr/http-factory": "^1.1"
    },
    "suggest": {
        "tobento/service-view": "Renderer implementation for render response.",
        "tobento/service-session": "Storage implementation for flashing input and messages."
    },    
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "nyholm/psr7": "^1.8",
        "tobento/service-view": "^2.0",
        "tobento/service-session": "^2.0",
        "tobento/service-middleware": "^2.0",
        "tobento/service-container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Responser\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Responser\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}